PORT=3001
FRONTEND_URL=http://localhost:5173

# Gemini API key (get from https://aistudio.google.com)
GEMINI_API_KEY=

# AI provider: gemini | claude | none
AI_PROVIDER=gemini

# Optional: Anthropic API key for Claude fallback
ANTHROPIC_API_KEY=

# Get Signa.AI API key (get from https://app.signa.ai)
SIGNA_API_KEY=

# Supabase coredb — for moat-finder research + flow event persistence
# Both apps share lcqsatefkutiakhgexue; service role key bypasses RLS
SUPABASE_URL=https://lcqsatefkutiakhgexue.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# ── Data Collector ──

# COLLECTOR_ENABLED:
# Rules:
#   Required?              No. Omit (or false) locally and on every deployment except one.
#   Format:                COLLECTOR_ENABLED: true | false
#   Default:               false (collector off; API usage is still counted when Supabase is configured)
#   Permission Required:   SUPABASE_SERVICE_ROLE_KEY + SIGNA_API_KEY must also be set
#   Purpose:               Records dark pool, flow, GEX, signals and option quotes for backtesting; two collectors double Signa usage
#
COLLECTOR_ENABLED=false

# SIGNA_DAILY_LIMIT:
# Rules:
#   Required?              No. Omit when your plan quota is 1,000 calls/day.
#   Format:                SIGNA_DAILY_LIMIT: <integer>
#   Default:               1000
#   Permission Required:   None
#   Purpose:               Signa quota shared by REST + MCP; raise it after buying a top-up
#
# SIGNA_DAILY_LIMIT=1000

# SIGNA_RESERVE_CALLS:
# Rules:
#   Required?              No.
#   Format:                SIGNA_RESERVE_CALLS: <integer>
#   Default:               200
#   Permission Required:   None
#   Purpose:               Calls kept free for dashboard browsing; collector jobs are skipped once usage reaches limit - reserve
#
# SIGNA_RESERVE_CALLS=200

# ── Flow Scanner ──

# SCANNER_PROMOTE_SCORE:
# Rules:
#   Required?              No.
#   Format:                SCANNER_PROMOTE_SCORE: <0-100>
#   Default:               45
#   Permission Required:   None
#   Purpose:               Radon discovery score a tradeable candidate needs before it is added to data collection (not a trade signal)
#
# SCANNER_PROMOTE_SCORE=45

# SCANNER_MAX_PROMOTED:
# Rules:
#   Required?              No.
#   Format:                SCANNER_MAX_PROMOTED: <integer>
#   Default:               12
#   Permission Required:   None
#   Purpose:               Cap on scanner-added symbols; each costs ~22 Signa calls per trading day
#
# SCANNER_MAX_PROMOTED=12

# SCANNER_DP_LOOKUPS:
# Rules:
#   Required?              No.
#   Format:                SCANNER_DP_LOOKUPS: <integer>
#   Default:               10
#   Permission Required:   None
#   Purpose:               Live dark pool pulls per scanner run (3 runs/day) for candidates not yet tracked
#
# SCANNER_DP_LOOKUPS=10
