# Backend API URL — REQUIRED for production (Cloudflare Pages).
# Set this to your Railway backend public URL.
# Without it, all /api/* requests hit the static host and return HTML instead of JSON.
# Leave blank for local development (Vite proxy handles routing to localhost:3001).
VITE_API_URL=https://your-railway-app.up.railway.app

# Supabase — enables Google sign-in and cross-device watchlist sync.
# Get both values from: Supabase Dashboard → your project → Settings → API
# Leave blank to run in localStorage-only mode (no auth required).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OAuth redirect URL — set this to your production domain (e.g. https://signal.ailab.build).
# This EXACT value must also be added to Supabase → Authentication → URL Configuration →
# Redirect URLs (use the exact URL, not a wildcard). Without this, Google sign-in will
# redirect to localhost:3000 (Supabase's default "Site URL") instead of your app.
# For local dev, leave blank — the app falls back to window.location.origin (localhost:5173).
VITE_SUPABASE_REDIRECT_URL=https://your-production-domain.com
